<%- include('partials/header') %>
    <main id="main-content" role="main">
        <h1>
            <%= title %>
        </h1>

        <section class="intro">
            <h2>Our Services</h2>
            <p>
                We offer a range of services to support community projects, partner
                organizations, and volunteers. Learn more about how we assist projects
                across categories and how you can get involved.
            </p>
        </section>

        <!-- Services / Categories -->
        <section class="category">
            <h2>Environmental Services</h2>
            <div class="service-list">
                <article>
                    <h3>Site Assessment & Planning</h3>
                    <p>
                        We help evaluate locations, plan logistics, and coordinate permits
                        for environmental projects and cleanups.
                    </p>
                </article>
                <article>
                    <h3>Volunteer Coordination</h3>
                    <p>
                        Our team matches volunteers with projects, handles scheduling, and
                        ensures safety guidelines are followed.
                    </p>
                </article>
            </div>
        </section>

        <section class="category">
            <h2>Educational Services</h2>
            <div class="service-list">
                <article>
                    <h3>Curriculum Support</h3>
                    <p>
                        We provide materials and program support for tutoring and literacy
                        initiatives.
                    </p>
                </article>
                <article>
                    <h3>Training Workshops</h3>
                    <p>
                        Volunteers and community leaders receive training to run safe,
                        effective educational programs.
                    </p>
                </article>
            </div>
        </section>

        <section class="category">
            <h2>Community Services</h2>
            <div class="service-list">
                <article>
                    <h3>Resource Distribution</h3>
                    <p>
                        We organize food drives, supply distribution, and other outreach
                        activities to support those in need.
                    </p>
                </article>
                <article>
                    <h3>Home Repair Assistance</h3>
                    <p>
                        Short-term repair and maintenance help for elderly residents and
                        families with limited resources.
                    </p>
                </article>
            </div>
        </section>

        <section class="cta">
            <h2>Get Involved</h2>
            <p>
                Want to partner or volunteer? Browse our projects page to find active
                opportunities and sign up.
            </p>
            <a href="/projects" class="button">Browse Projects</a>
        </section>
        <% if (user && user.role_name === 'user') { %>
            <section class="cta">
                <h2>Looking to Volunteer?</h2>
                <p>
                    Sign up to become a volunteer and get matched with projects that
                    fit your interests and schedule.
                </p>
                <a href="/add-volunteer" class="button">Register as a Volunteer</a>
            </section>
        <% } %>
    </main>

    <%- include('partials/footer') %>