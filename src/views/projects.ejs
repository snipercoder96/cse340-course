<%- include('partials/header') %>
    <main id="main-content" role="main">
        <h1>
            <%= title %>
        </h1>

        <section class="intro">
            <h2>Our Service Projects</h2>
            <p>
                Below are the current projects pulled from the database. Each one includes a
                location and projected date to help you choose where to get involved.
            </p>
        </section>

        <% if (projects && projects.length) { %>
            <section class="project-list">
                <% projects.forEach(project=> { %>
                    <article class="project-card">
                        <h2>
                            <%= project.title %>
                        </h2>
                        <p>
                            <%= project.description %>
                        </p>
                        <p><strong>Location:</strong>
                            <%= project.location %>
                        </p>
                        <p><strong>Partner Organization:</strong>
                            <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
                        </p>
                        <p><strong>Project Date:</strong>
                            <%= project.project_date ? new Date(project.project_date).toLocaleDateString() : 'TBA' %>
                        </p>
                        <a href="/project/<%= project.project_id %>" class="button">View Details</a>
                    </article>
                    <% }) %>
            </section>
            <% } else { %>
                <section class="empty-state">
                    <p>No projects are available at the moment. Please check back later.</p>
                </section>
                <% } %>

                    <section class="cta">
                        <h2>Want to see more?</h2>
                        <p>
                            Learn about our partner organizations or explore additional project categories.
                        </p>
                        <a href="/organizations" class="button">Meet Our Partner Organizations</a> |
                        <a href="/new-project">Add a New Service Project</a>
                    </section>
    </main>

    <%- include('partials/footer') %>