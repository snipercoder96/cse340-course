<%- include('partials/header') %>

    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>Dashboard</h2>
        <p>Name: <%= name %>
        </p>
        <p>Username: <%= email %>
        </p>
        <% if (user && user.role_name==='admin' ) { %>
                <a href="/show-all-users-access" role="menuitem" aria-current="<%= page === 'admin' ? 'page' : 'false' %>">
                    <span aria-hidden="false">⚙️</span> Admin Settings
                </a>
        <% } %>

    </main>

<%- include('partials/footer') %>