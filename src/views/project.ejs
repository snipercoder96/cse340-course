<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>
<% if (project) { %>
             <h2>
                 <%= project.title %>
             </h2>
             <p><strong>Date:</strong>
                 <%= project.project_date.toLocaleDateString('en-US', { year: 'numeric' , month: 'long' , day: 'numeric' }) %>
             </p>
             <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>">
                     <%= project.organization_name %>
                 </a></p>
             <p><strong>Location:</strong>
                 <%= project.location %>
             </p>
              <p><strong>Description:</strong>
                  <%= project.description %>
              </p>
              <% if (project.categories && project.categories.length > 0) { %>
              <p><strong>Categories:</strong>
                  <% project.categories.forEach(function(cat) { %>
                      <a href="/category/<%= cat.category_id %>"><%= cat.name %></a>
                  <% }); %>
              </p>
              <% } %>
              <% } else { %>
                <p>Project not found.</p>
                <%} %>
        
    </main>
<%- include('partials/footer') %>