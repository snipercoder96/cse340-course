<%- include('partials/header') %>
    <main id="main-content" role="main">
        <h1>
            <%= title %>
        </h1>

        <% if (usersPermissions && usersPermissions.length> 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                    </tr>
                </thead>
                <tbody>
                    <% usersPermissions.forEach(function(u) { %>
                        <tr>
                            <td>
                                <%= u.user_id %>
                            </td>
                            <td>
                                <%= u.name %>
                            </td>
                            <td>
                                <%= u.email %>
                            </td>
                            <td>
                                <span class="badge badge-<%= u.role_name %>">
                                    <%= u.role_name %>
                                </span>
                            </td>
                        </tr>
                        <% }); %>
                </tbody>
            </table>
            <% } else { %>
                <p>No users found.</p>
                <% } %>
    </main>
    <%- include('partials/footer') %>