<%- include('partials/header') %>
<main>
    <h1>All Users</h1>
    <% if (usersPermissions && usersPermissions.length > 0) { %>
        <ul>
            <% usersPermissions.forEach(function(user) { %>
                <li>
                    <strong><%= user.name %></strong> - <%= user.email %> (Role: <%= user.role_name %>)
                </li>
            <% }); %>
        </ul>
    <% } else { %>
        <p>No users found.</p>
    <% } %>
</main>
<%- include('partials/footer') %>

