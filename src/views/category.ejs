<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

         <h2>
             <%= `Our ${category.name} Projects` %>
         </h2>
         <img src="/images/<%= category.logo_filename %>" alt="<%= category.name %> logo">
         <p>Description: <%= category.description %></p>
         <% if (user && user.role === 'admin') { %>
             <a href="/edit-category/<%= category.category_id %>" class="button">Edit Category</a>
         <% } %>
    </main>
<%- include('partials/footer') %>