<!-- Update Project Form -->
<%- include('partials/header') %>
<form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
  <div>
    <label for="name">Name:</label>
    <input type="text" id="name" name="name" value="<%= projectDetails.name %>" required>
  </div>
  <div>
    <label for="description">Description:</label>
    <textarea id="description" name="description" required><%= projectDetails.description %></textarea>
  </div>
  <button type="submit">Update Project</button>
</form>
<%- include('partials/footer') %>