<%- include('partials/header') %>
    <main>
        <h1>
            <%= title %>
        </h1>

        <h2>
            <%= organizationDetails.name %>
        </h2>
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo">

        <p>Description: <%= organizationDetails.description %>
        </p>

        <h3>Service Projects</h3>
        <ul>
            <% projects.forEach(project=> { %>
                <li><a href="/project/<%= project.project_id %>">
                        <%= project.title %>
                    </a> - <%= new Date(project.project_date).toLocaleDateString("en-GB", {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric'
                      }) %></li>
                <% }) %>
        </ul>
        <p><%= organizationDetails.contact_email %></p> | 
        <a href="/edit-organization/<%= organizationDetails.organization_id %>">Edit Organization</a>
    </main>
<%- include('partials/footer') %>