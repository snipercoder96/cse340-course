<%- include('partials/header') %>
  <main id="main-content" role="main">
    <h1>
      <%= title %>
    </h1>

    <!-- Intro -->
    <section class="intro">
      <h2>Our Project Categories</h2>
      <p>
        Our service projects are organized into four main categories. Each category
        highlights a unique way to contribute, learn, and grow. Explore them below
        to find opportunities that match your interests.
      </p>
    </section>

    <!-- Categories -->
    <section class="categories-list">
      <% if (categories && categories.length) { %>
        <ul>
          <% categories.forEach(category=> { %>
            <li>
              <%= category.name %>
              <a href="/category/<%= category.category_id %>">View Details</a>
            </li>
            <% }) %>
        </ul>
        <% } else { %>
          <p>No categories are available at the moment.</p>
          <% } %>
    </section>

    <!-- Call to action -->
    <section class="cta">
      <h2>Get Started</h2>
      <p>
        Choose a category above to explore related projects and organizations.
        Every effort counts toward building a stronger, healthier community.
      </p>
         <a href="/organizations" class="button">Meet Our Partner Organizations</a>
         <% if(user && user.role_name === 'admin') { %>
         | <a href="/new-category" class="button">Create a New Category</a>
         <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>